---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts'
import { dateFormatter } from '../../utils/dateFormat'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const reading = await getCollection('reading')

  return reading.map((book) => ({
    params: { slug: book.id },
    props: book,
  }))
}

const book = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="my-16">
      <h1 class="font-display mt-8 mb-4 text-3xl text-mist-700 lg:text-4xl dark:text-mist-200 tracking-tighter">
        {book.data.title}
      </h1>
      <dl class="mt-4 divide-y divide-mist-200 dark:divide-mist-800">
        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-mist-500 font-display tracking-tighter">Completed</dt>
          <dd class="mt-1 sm:col-span-2 sm:mt-0 font-light">
            {dateFormatter.format(book.data.completed)}
          </dd>
        </div>
        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-mist-500 font-display tracking-tighter">Author</dt>
          <dd class="mt-1 sm:col-span-2 sm:mt-0 font-light">
            {Array.isArray(book.data.author)
              ? book.data.author.map((author, index) => (
                  <>
                    {index > 0 && ', '}
                    <span>{author}</span>
                  </>
                ))
              : book.data.author}
          </dd>
        </div>
        {book.data.translation && (
          <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
            <dt class="text-mist-500 font-display tracking-tighter">
              Translation
            </dt>
            <dd class="mt-1 sm:col-span-2 sm:mt-0 font-light">
              {book.data.translation}
            </dd>
          </div>
        )}
        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-mist-500 font-display tracking-tighter">ISBN</dt>
          <dd class="mt-1 sm:col-span-2 sm:mt-0 font-mono font-light">
            {Array.isArray(book.data.isbn)
              ? book.data.isbn.map((isbn, index) => (
                  <>
                    <span
                      class="whitespace-nowrap"
                      set:text={`${isbn}${index < book.data.isbn.length - 1 ? ',' : ''}`}
                    />
                  </>
                ))
              : book.data.isbn}
          </dd>
        </div>
      </dl>
    </main>
    <Footer />
  </body>
</html>
